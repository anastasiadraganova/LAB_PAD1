# Скопируйте в .env и вставьте свои ключи.
# Groq:   https://console.groq.com/keys
# Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...

# Langfuse — трассировка запросов (необязательно): https://cloud.langfuse.com → проект → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# регион EU — https://cloud.langfuse.com, регион US — https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
